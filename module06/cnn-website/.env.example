# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Get a key at https://newsapi.org/register -- the free "Developer" plan gives
# 100 requests a day, and this app spends one per page load.
NEWS_API_KEY=your-newsapi-key

# --- database -------------------------------------------------------------
# settings.py assembles the SQLAlchemy URL from these; compose.yaml feeds the
# same values to Postgres itself, so the two cannot disagree.
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=cnn
# Host-side view, for running the app with `uv run`. 5433 rather than 5432
# because ../postgres/compose.yaml already publishes 5432. Inside compose the
# web container overrides these to db:5432.
DB_HOST=localhost
DB_PORT=5433

# --- optional -------------------------------------------------------------
# DEFAULT_SOURCE=cnn
# PAGE_SIZE=12
# SECRET_KEY=change-me
