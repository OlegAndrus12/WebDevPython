# Everything listed here is never sent to the Docker daemon, so it can neither
# slow the build down nor end up in the image.

# The host virtualenv. Copying it in would be actively harmful: it is built
# for macOS, the image is Linux, and it would shadow the venv from stage 1.
.venv/

__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Docker's own files: the image does not need instructions for building itself.
Dockerfile
.dockerignore
docker-compose.yaml

.git/
.gitignore
README.md

# Inherited from module01/04_uv, where these exist to demonstrate packaging and
# linting tools. None of it is application code.
bandit_demo/
mypy_demo/
conflict/
pyproject.reference.toml
.pre-commit-config.yaml

# The dependency set actually installed comes from uv.lock via `uv sync`.
# This export exists in module01 only to show what `uv export` produces.
requirements.txt

# Tests run in CI and on the laptop, not inside the runtime image.
tests/
