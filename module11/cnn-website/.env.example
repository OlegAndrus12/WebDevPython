# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Get a key at https://newsapi.org/register -- the free "Developer" plan gives
# 100 requests a day, and `/` spends one per page load.
NEWS_API_KEY=your-newsapi-key

# --- database -------------------------------------------------------------
# settings.py assembles the SQLAlchemy URL from these; docker-compose.yaml
# feeds the same values to Postgres itself, so the two cannot disagree.
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=cnn
# Host-side view, for running uvicorn with `uv run`. 5411 follows the repo's
# port scheme -- every published port in this module ends in 11, the module
# number, so modules 06-11 can all run at once. Inside compose: db:5432.
DB_HOST=localhost
DB_PORT=5411

# --- auth -------------------------------------------------------------
# Signs and verifies every JWT. Generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key

# --- cache ----------------------------------------------------------------
# Defaults describe the redis service in docker-compose.yaml. Inside compose
# the api container overrides these to redis:6379.
# 6311 host-side, because 6379 is the port every other Redis wants.
REDIS_HOST=localhost
REDIS_PORT=6311
# How long a cached article stays servable. Writes invalidate the key, so this
# is the backstop rather than the main mechanism.
ARTICLE_CACHE_TTL_SECONDS=300

# Rate limit on /api/* -- a cooldown, not a quota: one request per this many
# seconds, per client IP, held in Redis so it applies across worker
# processes. A dead Redis fails open, because a broken limiter must not take
# the API down with it.
#
# Keep this small. The front-end fires several API calls per page load, and
# every one after the first inside the window is refused.
#
# 0 turns the limiter off entirely -- useful when hammering /api by hand, and
# what the test suite sets (tests/conftest.py); a suite that arrives from one
# IP would otherwise 429 itself on the second call of every test.
RATE_LIMIT_WINDOW_SECONDS=1

# --- mail -----------------------------------------------------------------
# Defaults describe the mailpit service in docker-compose.yaml: a dev SMTP
# sink with no auth, no TLS, and a web UI on http://localhost:8211. Inside
# compose the api container overrides MAIL_SERVER to `mailpit`.
# Every one of these has a working default in settings.py -- unlike
# SECRET_KEY, there is no secret here, so the app starts without them.
MAIL_SERVER=localhost
MAIL_PORT=1011
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false
MAIL_VALIDATE_CERTS=false
# Validated as an email address, and email-validator rejects reserved TLDs --
# .local and .test both fail here. .example is RFC 2606's documentation TLD.
MAIL_FROM=noreply@cnnreader.example
MAIL_FROM_NAME=CNN Reader
# How long a verification link stays good.
VERIFICATION_TOKEN_EXPIRE_MINUTES=60

# ...or point it at a real sandbox instead, e.g. Mailtrap, which does need
# credentials and STARTTLS:
# MAIL_SERVER=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<your mailtrap inbox username>
# MAIL_PASSWORD=<your mailtrap inbox password>
# MAIL_STARTTLS=true
# MAIL_USE_CREDENTIALS=true
# MAIL_VALIDATE_CERTS=true

# --- worker ---------------------------------------------------------------
# Celery's broker and result backend are Redis *database numbers* on the same
# server as the cache, which uses 0. Keep them apart: the FLUSHALL the README
# suggests for forcing cache misses would otherwise delete every queued job
# and beat's schedule with it.
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
# How long a task result stays visible in Flower before expiring.
CELERY_RESULT_EXPIRES_SECONDS=3600

# The app's own public URL, trailing slash included. The verification email
# can use request.base_url because a request sent it; the newsletter is sent
# by a worker, which has no request -- so this is the only way it can build a
# link somebody can click. Change it if you publish the api on another port.
PUBLIC_BASE_URL=http://localhost:8011/

# --- newsletter -----------------------------------------------------------
# When the newsletter goes out: 08:00 UTC, every day. Celery's beat_schedule
# takes a crontab(minute=, hour=, day_of_week=, day_of_month=, month_of_year=),
# a timedelta, or a bare number of seconds; a crontab is the right one for
# "every morning", since an interval drifts from the clock on every restart.
NEWSLETTER_HOUR=8
NEWSLETTER_MINUTE=0
# Most articles one email will list.
NEWSLETTER_MAX_ARTICLES=10

# --- stats report ---------------------------------------------------------
# When the daily stats report goes out to admins. 07:00 UTC, an hour before
# the newsletter, so the two do not compete for the worker.
#
# Who gets it is not configured here: it is every confirmed user whose `role`
# column is 'admin'. There is no endpoint that grants that -- promote someone
# in pgAdmin, or:
#   UPDATE users SET role = 'admin' WHERE email = 'you@example.com';
STATS_REPORT_HOUR=7
STATS_REPORT_MINUTE=0

# --- debug ----------------------------------------------------------------
# Turns on FastAPI's debug mode and, with it, the debug toolbar: SQL, timing,
# a sampling profiler and the resolved route, spliced into every HTML page
# before </body>. Nothing appears on /docs or on the JSON API -- there is no
# </body> to splice into.
#
# Development only. The panels show SQL with its bound parameters, every
# request header, and the whole route table, and the middleware buffers each
# response to rewrite it.
DEBUG=false

# --- optional -------------------------------------------------------------
# DEFAULT_SOURCE=cnn
# PAGE_SIZE=12
# ACCESS_TOKEN_EXPIRE_MINUTES=60
