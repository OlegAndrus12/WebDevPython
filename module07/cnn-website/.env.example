# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Get a key at https://newsapi.org/register -- the free "Developer" plan gives
# 100 requests a day, and `/` spends one per page load.
NEWS_API_KEY=your-newsapi-key

# --- database -------------------------------------------------------------
# settings.py assembles the SQLAlchemy URL from these; docker-compose.yaml
# feeds the same values to Postgres itself, so the two cannot disagree.
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=cnn
# Host-side view, for running uvicorn with `uv run`. 5435 because module05
# publishes 5433 and module07 5434. Inside compose the api container uses db:5432.
DB_HOST=localhost
DB_PORT=5435

# --- optional -------------------------------------------------------------
# DEFAULT_SOURCE=cnn
# PAGE_SIZE=12
