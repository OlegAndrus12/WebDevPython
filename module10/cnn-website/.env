# NewsAPI token. The free plan allows 100 requests a day and `/` spends one per load.
NEWS_API_KEY=13dd3cdef6aa48ff9a9aa7331117079a

# Postgres role the app connects as. docker-compose.yaml feeds the same value to the db.
DB_USER=admin
# Password for that role. settings.py URL-encodes it into the SQLAlchemy URL.
DB_PASSWORD=admin
# Database name, created by the db container on first start.
DB_NAME=cnn
# Host-side view, for `uv run` uvicorn. The api container overrides this to `db`.
DB_HOST=localhost
# Published port. 5410, so modules 06-11 can all run at once.
DB_PORT=5410

# Signs every JWT -- access tokens and the emailed verification link. `openssl rand -hex 32`.
SECRET_KEY=bf49dc83cb47af2a79f276ba2f12d8ff9fd5242ca8a6cc00f63e87df867df05e

# Mail: the mailpit sink from docker-compose.yaml. Web UI on
# http://localhost:8210. The api container overrides MAIL_SERVER to `mailpit`.
# SMTP host to hand the message to.
MAIL_SERVER=localhost
# SMTP port. 1010 is where mailpit is published; it wants no auth and no TLS.
MAIL_PORT=1010
# SMTP login name. Ignored while MAIL_USE_CREDENTIALS is false, but ConnectionConfig requires the field.
MAIL_USERNAME=
# SMTP password, the only real secret here. A SecretStr, unwrapped only at session.login().
MAIL_PASSWORD=
# Connect in plaintext, then upgrade to TLS before authenticating (ports 587/2525).
MAIL_STARTTLS=false
# Wrap the socket in TLS from the first byte instead (port 465). Set this or STARTTLS, never both.
MAIL_SSL_TLS=false
# Whether to attempt SMTP AUTH at all. This, not an empty password, is what skips the login.
MAIL_USE_CREDENTIALS=false
# Verify the server's TLS certificate. Must be true against a real provider, or TLS buys nothing.
MAIL_VALIDATE_CERTS=false
# Envelope sender. Validated as an email address; .example is RFC 2606's documentation TLD.
MAIL_FROM=noreply@cnnreader.example
# Display name shown beside MAIL_FROM in the recipient's client.
MAIL_FROM_NAME=CNN Reader
# How long the emailed link stays good. Longer than an access token: it has to survive an inbox.
VERIFICATION_TOKEN_EXPIRE_MINUTES=60

# Cache: the redis service from docker-compose.yaml. The api container
# overrides these to redis:6379.
# Cache host. The api container overrides this to `redis`, the service name.
REDIS_HOST=localhost
# Published port. 6310 because 6379 is the port every other Redis wants.
REDIS_PORT=6310
# Backstop expiry for a cached article body. Writes invalidate the key first.
ARTICLE_CACHE_TTL_SECONDS=300

# Rate limit on /api/* -- one request per this many seconds per client IP.
# 0 turns it off, which is what the front end needs here: a single page load
# fires two or three /api calls (/liked asks for /api/auth/me and
# /api/me/liked together), so any window above 0 refuses all but the first and
# the page renders empty. Raise it to 1 to watch the 429 happen.
RATE_LIMIT_WINDOW_SECONDS=0

# FastAPI debug mode and the debug toolbar (news/debug.py). On here, because
# this is a local sandbox and the toolbar is the point of module09's last step.
DEBUG=true
