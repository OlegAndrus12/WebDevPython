# Copy this file to .env and fill in NEWS_API_KEY. Both this file and .env are
# committed in this teaching repo, so keep anything genuinely secret out of
# both -- the values here are throwaway.

# --- NewsAPI ---------------------------------------------------------------
# Your API key from https://newsapi.org/register. Required: the app refuses to
# start without it. The free Developer plan allows 100 requests a day, and the
# front page spends exactly one per load.
NEWS_API_KEY=13dd3cdef6aa48ff9a9aa7331117079a

# --- database --------------------------------------------------------------
# Postgres login name. Compose feeds this same value to the database container
# as POSTGRES_USER, so the app and the server cannot disagree about it.
DB_USER=admin
# Postgres password. Read as a SecretStr, so it prints as ********** in logs and
# tracebacks, and is URL-escaped before going into the connection string.
DB_PASSWORD=admin
# Name of the database to connect to. Compose creates it as POSTGRES_DB.
DB_NAME=cnn
# Hostname of the database. `localhost` is the host-side view, for running the
# app directly with uv. Inside Compose the app container overrides this to `db`,
# the service name, which is its hostname on the Compose network.
DB_HOST=localhost
# Host-side port the database is published on. Inside Compose the app container
# overrides this to 5432, the port Postgres actually listens on in its network.
DB_PORT=5433

# --- optional --------------------------------------------------------------
# Which NewsAPI source the front page shows when there is no ?q= search.
# DEFAULT_SOURCE=cnn
# How many articles to request from NewsAPI per call. This is not the page size
# of the JSON API, which is the ?per_page= query parameter.
# PAGE_SIZE=12
